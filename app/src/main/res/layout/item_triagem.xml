<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    card_view:cardCornerRadius="20dp"
    card_view:cardElevation="4dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- LINHA SUPERIOR: Nome + Prioridade + Status -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- Nome + bolinha -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Henrique Silva"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <View
                    android:id="@+id/dotPrioridade"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="8dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/circle_gray"/>
            </LinearLayout>

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:text="Concluída"
                android:textColor="#1DB954"
                android:textSize="12sp"
                android:background="@drawable/status_background"/>
        </LinearLayout>

        <!-- SNS -->
        <TextView
            android:id="@+id/tvSNS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SNS: 123456789"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="#555"/>

        <!-- Data + Hora -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/icon_data_24"/>

            <TextView
                android:id="@+id/tvData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05/11/2024"
                android:layout_marginLeft="6dp"
                android:textSize="14sp"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_historico"
                android:layout_marginLeft="16dp"/>

            <TextView
                android:id="@+id/tvHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:layout_marginLeft="6dp"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Queixa -->
        <TextView
            android:id="@+id/tvQueixa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Queixa: Dores abdominais"
            android:textSize="15sp"/>

        <!-- Linha de separação -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDD"
            android:layout_marginTop="12dp"/>

        <!-- Enfermeiro -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/icon_perfil_24"/>

            <TextView
                android:id="@+id/tvEnfermeiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enf. Maria Santos"
                android:layout_marginLeft="6dp"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
