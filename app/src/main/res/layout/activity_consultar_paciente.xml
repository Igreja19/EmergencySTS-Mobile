<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔹 Fundo gradiente -->
    <pt.ipleiria.estg.dei.emergencysts.GradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 🔹 Conteúdo sobreposto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 🟩 CARD SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="22dp"
            android:elevation="10dp">

            <!-- Seta + título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_voltaratras"
                    app:tint="#222"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consultar Paciente"
                    android:textColor="#222"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Subtítulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesquise por NIF"
                android:textColor="#777"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <!-- SEARCH BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="#999"/>

                <EditText
                    android:id="@+id/edtNif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pesquisar paciente..."
                    android:background="@android:color/transparent"
                    android:textColor="#222"
                    android:textColorHint="#AAA"
                    android:paddingStart="8dp"
                    android:inputType="number" />
            </LinearLayout>

        </LinearLayout>



        <!-- 🟦 RESULTADO DO PACIENTE (ESCONDIDO INICIALMENTE) -->
        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_margin="16dp"
            android:elevation="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Paciente"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222"/>

            <TextView
                android:id="@+id/tvNif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="NIF: ---"
                android:textSize="14sp"
                android:textColor="#555"/>

            <TextView
                android:id="@+id/tvSns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SNS: ---"
                android:textSize="14sp"
                android:textColor="#555"/>
        </LinearLayout>


        <!-- 🟧 ESTADO INICIAL -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_user_placeholder"
                app:tint="#575555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Digite um NIF para pesquisar"
                android:textColor="#575555"
                android:textSize="15sp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
