<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FUNDO GRADIENT -->
    <pt.ipleiria.estg.dei.emergencysts.GradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HEADER FULL WIDTH -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12A84C"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuração da API"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SCROLLVIEW DO CONTEÚDO (ABAIXO DO HEADER) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ÍCONE CENTRAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="20dp">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_circle_white"
                    android:padding="26dp"
                    android:src="@drawable/ic_server"
                    app:tint="#12A84C" />
            </LinearLayout>

            <!-- TÍTULO SECÇÃO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configuração do Servidor"
                android:gravity="center"
                android:textColor="#333"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="14dp" />

            <!-- BLOCO BRANCO ARREDONDADO (SEM SOMBRAS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_rounded"
                android:padding="22dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="10dp">

                <!-- LABEL URL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="URL do Servidor (IP ou domínio)"
                    android:textColor="#444"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <!-- INPUT URL -->
                <EditText
                    android:id="@+id/editServerIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="http://192.168.1.100"
                    android:padding="16dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/rounded_input"
                    android:textColor="#000"
                    android:textColorHint="#999" />

                <!-- LABEL API PATH -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Caminho da API"
                    android:textColor="#444"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="20dp" />

                <!-- INPUT API PATH -->
                <EditText
                    android:id="@+id/editApiPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="/EmergencySTS/advanced/backend/web/"
                    android:padding="16dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/rounded_input"
                    android:textColor="#000"
                    android:textColorHint="#999" />

                <!-- BOTÃO GUARDAR -->
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar Configuração"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_marginTop="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@drawable/rounded_button" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
