<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FUNDO GRADIENT -->
    <pt.ipleiria.estg.dei.emergencysts.GradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- CONTEÚDO PRINCIPAL -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_voltaratras" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Detalhes da Triagem"
                android:textColor="#333"
                android:textStyle="bold"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- ÁREA SCROLL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CARD VERDE: Dados do paciente -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/card_green_rounded">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dados do Paciente"
                        android:textColor="#00894A"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome"
                        android:textStyle="bold"
                        android:textColor="#00894A" />

                    <TextView
                        android:id="@+id/tvNomeValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Henrique Silva"
                        android:layout_marginBottom="8dp"
                        android:textColor="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data de Nascimento             SNS"
                        android:textStyle="bold"
                        android:textColor="#00894A" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDataNascimento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="15/03/1990" />

                        <TextView
                            android:id="@+id/tvSNS"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="123456789" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTelefoneLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefone"
                        android:textStyle="bold"
                        android:textColor="#00894A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvTelefoneValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+351 912 345 678"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- CARD INFORMAÇÃO CLÍNICA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_white_rounded">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informação Clínica"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Motivo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Motivo da Consulta"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvMotivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulta de urgência devido a dores intensas"
                        android:layout_marginBottom="12dp" />

                    <!-- Queixa -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Queixa Principal"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvQueixa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dores abdominais"
                        android:layout_marginBottom="12dp" />

                    <!-- Descrição -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descrição de Sintomas"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvDescricao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Náuseas, vómitos e dores abdominais"
                        android:layout_marginBottom="12dp" />

                    <!-- Início -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Início dos Sintomas"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvInicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Há 6 horas"
                        android:layout_marginBottom="12dp" />

                    <!-- Intensidade -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Intensidade da Dor (1-10)"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvDor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 - Forte"
                        android:layout_marginBottom="12dp" />

                    <!-- Alergias -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alergias"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvAlergias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Penicilina"
                        android:layout_marginBottom="12dp" />

                    <!-- Medicação -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medicação Atual"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvMedicacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paracetamol 1000mg"
                        android:layout_marginBottom="12dp" />

                    <!-- Prioridade -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prioridade da Pulseira"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/dotPrioridade"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:background="@drawable/circle_yellow" />

                        <TextView
                            android:id="@+id/tvPrioridade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amarelo - Urgente" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CARD ENFERMEIRO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_white_rounded">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enfermeiro Responsável"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvEnfermeiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enf. Maria Santos"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Data"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvData"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="05/11/2024" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hora"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHora"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14:30" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- BOTÃO FINAL -->
        <Button
            android:id="@+id/btnApagar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:text="Apagar Triagem"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_red"
            android:backgroundTint="@null"/>

    </LinearLayout>

</FrameLayout>
